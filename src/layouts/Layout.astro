---
import "../styles/global.css";

const site = "https://average-time-calculator.com";
const { title, description, canonical = `${site}/`, schema, noindex = false } = Astro.props;

const navItems = [
  { href: "#tool", label: "Tool" },
  { href: "#formula", label: "Formula" },
  { href: "#how-to-use", label: "How to Use" },
  { href: "#use-cases", label: "Use Cases" },
  { href: "#advanced", label: "Advanced" },
  { href: "#metrics", label: "Metrics" },
  { href: "#accuracy", label: "Accuracy" },
  { href: "#spreadsheet-formulas", label: "Spreadsheet" },
  { href: "#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#047857" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Average Time Calculator" />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Average Time Calculator tool preview" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:updated_time" content="2026-08-13" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta name="twitter:image:alt" content="Average Time Calculator tool preview" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/95 backdrop-blur">
      <div class="page-shell flex h-16 items-center justify-between">
        <a href="/" class="font-semibold tracking-[-0.02em] text-zinc-950">
          Average Time Calculator
        </a>
        <nav aria-label="Page sections" class="hidden items-center gap-6 text-sm font-medium text-zinc-600 sm:flex">
          {navItems.map((item) => (
            <a href={item.href} class="transition-colors hover:text-emerald-700">{item.label}</a>
          ))}
        </nav>
        <a
          href="https://github.com/jiusongvip/average-time-calculator"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm font-semibold text-zinc-900 transition hover:border-zinc-400 hover:bg-zinc-50"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span class="hidden lg:inline">Open source</span>
        </a>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 bg-white">
      <div class="page-shell flex flex-col gap-6 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_auto] lg:gap-8">
          <div>
            <p class="font-semibold text-zinc-900">Average Time Calculator</p>
            <p class="mt-2 text-xs leading-relaxed">
              Free, private time tool for durations, clock times, weighted averages, and running averages. All calculations happen in your browser.
            </p>
          </div>
          <div>
            <nav aria-label="Footer sections" class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-zinc-600">
              {navItems.map((item) => (
                <a href={item.href} class="transition-colors hover:text-emerald-700">{item.label}</a>
              ))}
              <a href="#verification" class="transition-colors hover:text-emerald-700">Verification</a>
              <a href="#industry-use-cases" class="transition-colors hover:text-emerald-700">Industries</a>
              <a href="#glossary" class="transition-colors hover:text-emerald-700">Glossary</a>
              <a href="#about" class="transition-colors hover:text-emerald-700">About</a>
              <a href="#privacy" class="transition-colors hover:text-emerald-700">Privacy</a>
            </nav>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-zinc-500">
              <a
                href="https://github.com/jiusongvip/average-time-calculator"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-medium text-emerald-700 hover:underline"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
                Open source on GitHub
              </a>
              <a href="https://github.com/jiusongvip/average-time-calculator/issues" target="_blank" rel="noopener noreferrer" class="font-medium text-emerald-700 hover:underline">
                Report an issue
              </a>
            </div>
            <p class="mt-3 text-xs">Last updated: August 17, 2026</p>
          </div>
        </div>
      </div>
    </footer>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </body>
</html>
