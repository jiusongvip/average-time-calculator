---
import Layout from "../layouts/Layout.astro";

const title = "Page Not Found - Average Time Calculator";
const description =
  "This page could not be found. Return to the average time calculator to average durations or clock times.";
---

<Layout title={title} description={description} canonical="https://average-time-calculator.com/404/" noindex>
  <section class="section-pad">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.08em] text-emerald-700">404</p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-[-0.04em] text-zinc-950 sm:text-4xl">
          This page could not be found.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-600">
          The link may be out of date, or the page may have moved. The calculator itself is still right where it should be.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/#tool"
            class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800 active:translate-y-px"
          >
            Open the calculator
          </a>
          <a
            href="/"
            class="rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 transition hover:border-zinc-400 hover:bg-zinc-50 active:translate-y-px"
          >
            Back to home
          </a>
        </div>
      </div>
      <div class="grid gap-4">
        <div class="rounded-lg border border-zinc-200 bg-white p-6">
          <h2 class="text-base font-semibold text-zinc-950">Popular sections</h2>
          <ul class="mt-4 grid gap-3 text-sm text-zinc-600">
            <li>
              <a href="/#formula" class="font-medium text-emerald-700 hover:underline">
                Average time formula
              </a>
            </li>
            <li>
              <a href="/#how-to-use" class="font-medium text-emerald-700 hover:underline">
                How to use the calculator
              </a>
            </li>
            <li>
              <a href="/#spreadsheet-formulas" class="font-medium text-emerald-700 hover:underline">
                Spreadsheet formulas
              </a>
            </li>
            <li>
              <a href="/#faq" class="font-medium text-emerald-700 hover:underline">
                Frequently asked questions
              </a>
            </li>
          </ul>
        </div>
        <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-6">
          <h2 class="text-base font-semibold text-zinc-950">Found a broken link?</h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            Report it so it can be fixed in the next update.
          </p>
          <a
            href="https://github.com/jiusongvip/average-time-calculator/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block text-sm font-semibold text-emerald-700 hover:underline"
          >
            Report on GitHub →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
