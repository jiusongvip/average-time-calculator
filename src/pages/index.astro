    </div>
  </section>

  <script>
    const copyEmbedCodeButton = document.getElementById("copy-embed-code");

    if (copyEmbedCodeButton) {
      copyEmbedCodeButton.addEventListener("click", async () => {
        const embedCode =
          '<iframe src="https://average-time-calculator.com/embed" width="100%" height="720" loading="lazy" title="Average Time Calculator"></iframe>';

        try {
          await navigator.clipboard.writeText(embedCode);
          copyEmbedCodeButton.textContent = "Copied";
          window.setTimeout(() => {
            copyEmbedCodeButton.textContent = "Copy code";
          }, 1400);
        } catch {
          copyEmbedCodeButton.textContent = "Copy unavailable";
        }
      });
    }
  </script>

