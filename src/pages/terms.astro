---
import Layout from "../layouts/Layout.astro";

const title = "Terms of Use - Average Time Calculator";
const description =
  "Terms of use for Average Time Calculator. Free to use and content is provided as-is for informational purposes. Verify important figures before relying on them.";
const dateModified = "2026-09-03";
const datePublished = "2026-08-13";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.average-time-calculator.com/#organization",
      name: "Average Time Calculator",
      url: "https://www.average-time-calculator.com/",
      sameAs: ["https://github.com/jiusongvip/average-time-calculator"],
      foundingDate: "2026-08-13",
    },
    {
      "@type": "WebPage",
      "@id": "https://www.average-time-calculator.com/terms/#webpage",
      url: "https://www.average-time-calculator.com/terms/",
      name: "Terms of Use - Average Time Calculator",
      description,
      inLanguage: "en",
      datePublished,
      dateModified,
      publisher: {
        "@id": "https://www.average-time-calculator.com/#organization",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://www.average-time-calculator.com/#website",
      url: "https://www.average-time-calculator.com/",
      name: "Average Time Calculator",
      description,
      inLanguage: "en",
      publisher: {
        "@id": "https://www.average-time-calculator.com/#organization",
      },
    },
  ],
};
---

<Layout title={title} description={description} canonical="https://www.average-time-calculator.com/terms/" schema={schema}>
  <section class="section-pad">
    <div class="page-shell max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.08em] text-emerald-700">Terms</p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-[-0.04em] text-zinc-950 sm:text-4xl">Terms of use</h1>
      <p class="mt-5 text-base leading-relaxed text-zinc-600">The calculator is free to use, and the content on this page is provided as-is for informational purposes.</p>

      <h2 class="mt-12 text-2xl font-semibold tracking-[-0.02em] text-zinc-950">Can I rely on the results?</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-600">Results are informational. Verify important figures against your own records or a spreadsheet before relying on them.</p>
      <h3 class="mt-6 text-lg font-semibold tracking-[-0.01em] text-zinc-950">How should I verify the calculation?</h3>
      <p class="mt-2 text-sm leading-relaxed text-zinc-600">Cross-check a few values against a spreadsheet formula. The verification section on the homepage maps each calculation to its spreadsheet equivalent.</p>

      <h2 class="mt-12 text-2xl font-semibold tracking-[-0.02em] text-zinc-950">How is the content licensed?</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-600">Source code is on GitHub. Page content may be quoted with attribution, such as a link back here.</p>
      <h3 class="mt-6 text-lg font-semibold tracking-[-0.01em] text-zinc-950">Can I use the calculator on my own site?</h3>
      <p class="mt-2 text-sm leading-relaxed text-zinc-600">Yes — use the embed feature on the homepage to add the calculator to any article. All calculations still run in the visitor's browser.</p>
    </div>
  </section>
</Layout>